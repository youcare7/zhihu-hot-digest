# ============================================================================
# 热榜深潜简报 · 环境变量模板
# 使用方法：复制本文件为 .env（或直接按 README 在终端设置环境变量）。
# 注意：.env 绝不能提交到公开仓库（.gitignore 已包含）。
# 本文件只包含键名与占位说明，不含任何真实密钥。
# ============================================================================

# 知乎开放平台 Access Secret（等同密码，必填；mock 模式除外）
ZHIHU_ACCESS_SECRET=

# 知乎开放平台 Base（一般不用改）
ZHIHU_BASE=https://developer.zhihu.com

# 生成层首选「知乎直答」的模型（zhida-fast-1p5 / zhida-thinking-1p5 / zhida-agent）
ZHIDA_MODEL=zhida-fast-1p5

# 备选通用大模型（仅当配置了以下三项且知乎直答失败时才会使用；可留空）
MODEL_API_KEY=
MODEL_BASE=
MODEL_NAME=

# 1 = mock 模式：不请求知乎 API，用本地模拟数据跑通全链路（页面会标注「模拟数据」）
MOCK_MODE=0

# 服务端口（部署平台若提供 PORT 环境变量则自动使用）
PORT=5000

# 上游接口超时时间（秒）
REQUEST_TIMEOUT=30

# 当日缓存有效期（小时）；0 表示当天仅无缓存时生成
CACHE_TTL_HOURS=3

# 刷新异常、整批 0 条成功或劣化结果被丢弃后的冷却时间（秒）
# 防止访客流量反复触发整批生成；默认 15 分钟
REFRESH_COOLDOWN_SECONDS=900

# 知乎直答 429 退避等待秒数与总尝试次数（含首次）
RETRY_WAIT=30
RETRY_TIMES=6
